# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://chores:chores@localhost:5432/chores
# Tests use a separate database (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://chores:chores@localhost:5432/chores_test

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

PORT=3000
# Comma-separated origins allowed to call the API from a browser (Expo web dev server).
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
# Run the scheduled jobs (planning, late marking) inside the API process.
# Set to false if a separate worker runs them (`pnpm --filter @titan/api worker`).
RUN_JOBS=true

# Photo storage (S3-compatible). These defaults match docker-compose (RustFS).
# S3_ENDPOINT=http://localhost:9000
# Where phones and browsers reach storage; signed URLs use this host.
# Unset in development = this computer's LAN address (so Expo Go on the same Wi-Fi works).
# S3_PUBLIC_URL=http://192.168.1.20:9000
# S3_BUCKET=titan-photos
# S3_ACCESS_KEY=chores
# S3_SECRET_KEY=chores-dev-secret

# Push notifications go through Expo's push service; no key is needed unless
# "enhanced push security" is turned on for the Expo project.
# EXPO_ACCESS_TOKEN=

# Behind a hosting proxy, trust X-Forwarded-For: "true", "false", or a hop count.
# TRUST_PROXY=false
# The web sign-in cookie is Secure (https only); defaults to true in production.
# COOKIE_SECURE=false
