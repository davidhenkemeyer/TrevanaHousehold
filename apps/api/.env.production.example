# Production settings for the API. Set these as secrets on the host
# (e.g. `fly secrets set NAME=value`), never in a committed file.
# The API refuses to start in production if a required one is missing or is a
# development default. See docs/deploy.md for where each value comes from.

NODE_ENV=production

# Neon (or any Postgres 16). Use the pooled connection string for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 32+ random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out of their 15-minute access tokens (refresh still works).
JWT_SECRET=

# The web app's address (comma-separate several). https only, no wildcards.
CORS_ORIGINS=https://app.example.com

PORT=3000
LOG_LEVEL=info
# Jobs run inside the API (one machine). Set false if a separate worker runs them.
RUN_JOBS=true
# Fly.io, Railway, and Render put one proxy in front of the app.
TRUST_PROXY=1

# Photo storage: Cloudflare R2 or AWS S3.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Where phones and browsers reach storage (usually the same as S3_ENDPOINT). https only.
S3_PUBLIC_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=tenara-photos
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Only if "enhanced push security" is on for the Expo project.
# EXPO_ACCESS_TOKEN=

# Subscriptions (RevenueCat). The secret API key (Project settings > API keys,
# "Secret") reads each family's Pro status. The webhook value is the exact
# Authorization header you set on RevenueCat's webhook (Integrations > Webhooks),
# e.g. "Bearer <a long random string>". Point the webhook at
# https://api.<domain>/v1/billing/revenuecat.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
