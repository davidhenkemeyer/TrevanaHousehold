// Database schema. Change it, then run `pnpm --filter @titan/api db:migrate --name <change>`
// to create a migration. Chore tables arrive in Step 3 as their own migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  CHILD
}

/// A person. Parents and older kids sign in with email + password; kid profiles
/// created by a parent have neither and are reached by switching profiles on a
/// family device (see Membership.pinHash).
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lowercased. Null for kid profiles.
  email        String?  @unique
  passwordHash String?
  displayName  String
  avatarColor  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  invitesSent   Invite[]       @relation("InviteCreatedBy")
}

model Family {
  id             String         @id @default(uuid(7)) @db.Uuid
  name           String
  /// IANA zone, e.g. "America/Chicago". All scheduling happens in this zone.
  timeZone       String
  /// What chores pay in. Changing it never converts or erases ledger entries.
  rewardCurrency RewardCurrency @default(NONE)
  /// ISO code used when rewardCurrency is MONEY (amounts are in cents).
  currencyCode   String         @default("USD")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  memberships Membership[]
  invites     Invite[]
  chores      Chore[]
  instances   ChoreInstance[]
  uploads     Upload[]
  ledger      LedgerEntry[]
  rewardItems RewardItem[]
  redemptions Redemption[]
}

/// A user's place in a family: their role and capacity there. (Reward
/// balances aren't stored here; they're sums over LedgerEntry.)
model Membership {
  id                String    @id @default(uuid(7)) @db.Uuid
  familyId          String    @db.Uuid
  userId            String    @db.Uuid
  role              Role
  /// Minutes of chore time per weekday: { sun, mon, ..., sat }.
  capacity          Json
  /// Kid profiles only: PIN asked when a sibling switches to this profile.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  /// Removed members are deactivated, not deleted, so their history survives.
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  choresCreated      Chore[]            @relation("ChoreCreatedBy")
  pairingCodes       PairingCode[]      @relation("PairingCodeFor")
  pairingsMade       PairingCode[]      @relation("PairingCodeCreatedBy")
  eligibleFor        ChoreEligible[]
  assignments        InstanceAssignee[]
  events             InstanceEvent[]
  submissions        Submission[]
  reviewsWritten     Review[]
  uploads            Upload[]
  ledger             LedgerEntry[]      @relation("LedgerMember")
  ledgerWritten      LedgerEntry[]      @relation("LedgerCreatedBy")
  redemptions        Redemption[]       @relation("RedemptionMember")
  redemptionsDecided Redemption[]       @relation("RedemptionDecidedBy")

  @@unique([familyId, userId])
  @@index([userId])
}

/// An invitation for someone with an email address to join a family.
model Invite {
  id               String    @id @default(uuid(7)) @db.Uuid
  familyId         String    @db.Uuid
  email            String
  role             Role
  /// SHA-256 of the secret token; the token itself is never stored.
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?   @db.Uuid
  revokedAt        DateTime?
  createdByUserId  String    @db.Uuid
  createdAt        DateTime  @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

/// One session's long-lived refresh token. Tokens rotate on every use; presenting
/// an already-used token revokes all of that user's sessions (likely theft).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time code that signs a kid's own phone in to their profile, so a
/// parent's password never has to be typed on the kid's device.
model PairingCode {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// The kid profile the code signs in to.
  membershipId String    @db.Uuid
  /// SHA-256 of the normalized code; the code itself is never stored.
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdById  String    @db.Uuid
  createdAt    DateTime

  membership Membership @relation("PairingCodeFor", fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  Membership @relation("PairingCodeCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

// ─── Chores ────────────────────────────────────────────────────────────────
// Enum values must match the constants in packages/domain exactly
// (checked by apps/api/src/modules/enums.test.ts).

enum ChoreStatus {
  NEW
  IN_PROGRESS
  DEFERRED
  PENDING_REVIEW
  APPROVED
  NEEDS_REWORK
  REJECTED
  CANCELED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum AssignMode {
  FIXED
  ROTATE
  AUTO
  /// Job board: nobody is assigned until someone claims the occurrence.
  OPEN
}

enum RewardCurrency {
  NONE
  MONEY
  POINTS
}

/// Routine = baseline duty (no coins by default). Extra job = optional, earns coins.
enum ChoreKind {
  ROUTINE
  EXTRA_JOB
}

/// NONE: ordinary chore. OPEN: on the job board. CLAIMED: taken from the board.
enum BoardState {
  NONE
  OPEN
  CLAIMED
}

enum ReviewPolicy {
  REVIEW_EACH
  BATCH_OK
  AUTO_APPROVE
}

enum ReviewAction {
  APPROVE
  REQUEST_REWORK
  REJECT
}

/// A chore definition ("template"). Its recurrence produces dated ChoreInstances.
model Chore {
  id                String       @id @default(uuid(7)) @db.Uuid
  familyId          String       @db.Uuid
  name              String
  description       String       @default("")
  /// Situational trigger shown on the card, e.g. "After dinner" (branding doc: implementation intentions).
  cue               String?
  kind              ChoreKind    @default(ROUTINE)
  effortMinutes     Int
  defaultPriority   Priority     @default(NORMAL)
  requiresPhoto     Boolean      @default(false)
  reviewPolicy      ReviewPolicy @default(REVIEW_EACH)
  /// In the family's reward currency (cents or points). Paid out from Step 8.
  rewardAmount      Int          @default(0)
  /// RecurrenceRule JSON; see packages/domain/src/recurrence.ts.
  recurrence        Json
  /// Due this long after the occurrence becomes available.
  deadlineMinutes   Int
  assignMode        AssignMode
  /// "Golden standard" photo shown to kids and next to submissions in review.
  /// A storage key from the upload flow; kept until replaced or removed.
  referencePhotoKey String?
  /// Archived chores stop producing occurrences; their history stays.
  active            Boolean      @default(true)
  createdById       String       @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  family    Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy Membership           @relation("ChoreCreatedBy", fields: [createdById], references: [id])
  checklist ChoreChecklistItem[]
  eligible  ChoreEligible[]
  instances ChoreInstance[]

  @@index([familyId, active])
}

model ChoreChecklistItem {
  id       String @id @default(uuid(7)) @db.Uuid
  choreId  String @db.Uuid
  position Int
  text     String

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@index([choreId])
}

/// FIXED: the chore's owners. ROTATE/AUTO: the candidate pool, in rotation order.
model ChoreEligible {
  choreId      String @db.Uuid
  membershipId String @db.Uuid
  position     Int

  chore      Chore      @relation(fields: [choreId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([choreId, membershipId])
}

/// One dated occurrence of a chore, assigned to one or more members.
/// Never update `status` directly: go through modules/instances/transitions.ts.
model ChoreInstance {
  id             String      @id @default(uuid(7)) @db.Uuid
  choreId        String      @db.Uuid
  familyId       String      @db.Uuid
  /// Local calendar date in the family's time zone.
  occurrenceDate DateTime    @db.Date
  availableAt    DateTime
  dueAt          DateTime
  status         ChoreStatus @default(NEW)
  isLate         Boolean     @default(false)
  /// Job board state. Change it only through modules/instances/transitions.ts.
  board          BoardState  @default(NONE)
  priority       Priority
  /// Snapshots taken at planning time, so later chore edits don't change history.
  rewardAmount   Int
  effortMinutes  Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  chore       Chore              @relation(fields: [choreId], references: [id], onDelete: Cascade)
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignees   InstanceAssignee[]
  events      InstanceEvent[]
  submissions Submission[]
  ledger      LedgerEntry[]

  @@unique([choreId, occurrenceDate])
  @@index([familyId, occurrenceDate])
  @@index([familyId, status])
}

model InstanceAssignee {
  instanceId   String @db.Uuid
  membershipId String @db.Uuid

  instance   ChoreInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([instanceId, membershipId])
  @@index([membershipId])
}

/// Audit trail: one row per status change.
model InstanceEvent {
  id                String      @id @default(uuid(7)) @db.Uuid
  instanceId        String      @db.Uuid
  /// Null when the system acted (e.g. auto-approval, late marking).
  actorMembershipId String?     @db.Uuid
  action            String
  fromStatus        ChoreStatus
  toStatus          ChoreStatus
  createdAt         DateTime    @default(now())

  instance ChoreInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    Membership?   @relation(fields: [actorMembershipId], references: [id])

  @@index([instanceId])
}

/// One attempt at completing an occurrence: checklist state and photos.
model Submission {
  id              String    @id @default(uuid(7)) @db.Uuid
  instanceId      String    @db.Uuid
  submittedById   String    @db.Uuid
  submittedAt     DateTime
  /// [{ itemId, text, checked }], with text snapshotted.
  checklistState  Json
  /// Storage keys from the upload flow. Never client-supplied URLs.
  photoKeys       String[]  @default([])
  /// Set when the photos were deleted (90 days after review); photoKeys is then empty.
  photosDeletedAt DateTime?

  instance    ChoreInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  submittedBy Membership    @relation(fields: [submittedById], references: [id])
  reviews     Review[]

  @@index([instanceId])
}

/// A decision on a submission.
model Review {
  id           String       @id @default(uuid(7)) @db.Uuid
  submissionId String       @db.Uuid
  /// Null for automatic approvals (AUTO_APPROVE policy).
  reviewerId   String?      @db.Uuid
  action       ReviewAction
  note         String?
  /// Pin annotations: { pins: [{ pin, xPercent, yPercent, comment }] }.
  annotations  Json?
  /// True when approved via "Approve all low-stakes".
  batch        Boolean      @default(false)
  createdAt    DateTime

  submission Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   Membership? @relation(fields: [reviewerId], references: [id])

  @@index([submissionId])
}

enum UploadPurpose {
  /// Proof photo attached to a submission.
  SUBMISSION
  /// A chore's reference ("golden standard") photo.
  REFERENCE
}

/// A photo upload the API authorized. The app uploads the file straight to
/// storage, then refers to it by this id (never by key or URL). An upload can
/// be attached once; unused ones are cleaned up after they expire.
model Upload {
  id          String        @id @default(uuid(7)) @db.Uuid
  familyId    String        @db.Uuid
  createdById String        @db.Uuid
  purpose     UploadPurpose
  /// Storage key: families/{familyId}/{purpose}/{uuid}.
  key         String        @unique
  contentType String
  createdAt   DateTime
  /// The upload form stops working at this time.
  expiresAt   DateTime
  /// When it was attached to a submission or chore.
  usedAt      DateTime?

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy Membership @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([expiresAt])
}

enum LedgerType {
  /// A chore was approved.
  EARNED
  /// A parent paid money out (negative).
  PAYOUT
  /// Points held for a catalog reward (negative).
  REDEMPTION
  /// The request was denied or canceled (positive).
  REDEMPTION_REFUND
  /// A parent fixed a mistake (either sign; always has a note).
  CORRECTION
}

/// One change to a member's rewards. Balances are never stored: a balance is
/// the sum of a member's entries in a currency. Entries are never edited or
/// deleted; mistakes are fixed with a CORRECTION entry.
model LedgerEntry {
  id           String         @id @default(uuid(7)) @db.Uuid
  familyId     String         @db.Uuid
  membershipId String         @db.Uuid
  /// MONEY or POINTS (never NONE): the currency this entry was made in.
  currency     RewardCurrency
  /// For MONEY entries.
  currencyCode String?
  /// Signed: cents or points.
  amount       Int
  type         LedgerType
  instanceId   String?        @db.Uuid
  redemptionId String?        @db.Uuid
  note         String?
  /// The parent who recorded it; null for automatic entries.
  createdById  String?        @db.Uuid
  createdAt    DateTime

  family     Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  membership Membership     @relation("LedgerMember", fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  Membership?    @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  instance   ChoreInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  redemption Redemption?    @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  /// An approval can never pay the same member twice for one occurrence.
  @@unique([instanceId, membershipId, type])
  @@index([familyId, membershipId, currency])
  @@index([membershipId, createdAt])
}

/// A non-monetary reward kids can spend points on ("30 min screen time").
model RewardItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  familyId  String   @db.Uuid
  name      String
  /// In points.
  cost      Int
  /// Removed items are hidden, not deleted, so past requests keep their meaning.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@index([familyId])
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  DENIED
  CANCELED
}

/// A request to spend points on a reward. The points are held when it's made
/// (a REDEMPTION ledger entry) and given back if it's denied or canceled.
model Redemption {
  id           String           @id @default(uuid(7)) @db.Uuid
  familyId     String           @db.Uuid
  membershipId String           @db.Uuid
  itemId       String           @db.Uuid
  /// Snapshots, so later catalog edits don't change what was asked for.
  itemName     String
  cost         Int
  status       RedemptionStatus @default(REQUESTED)
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?
  note         String?
  createdAt    DateTime

  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  membership Membership    @relation("RedemptionMember", fields: [membershipId], references: [id], onDelete: Cascade)
  decidedBy  Membership?   @relation("RedemptionDecidedBy", fields: [decidedById], references: [id])
  item       RewardItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ledger     LedgerEntry[]

  @@index([familyId, status])
  @@index([membershipId])
}
