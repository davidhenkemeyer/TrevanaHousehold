{
  "name": "@titan/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify REST API and background jobs for the chores app.",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "job:plan": "tsx --env-file-if-exists=.env src/jobs/run-once.ts plan",
    "job:mark-late": "tsx --env-file-if-exists=.env src/jobs/run-once.ts mark-late",
    "job:cleanup-photos": "tsx --env-file-if-exists=.env src/jobs/run-once.ts cleanup-photos",
    "job:send-instant": "tsx --env-file-if-exists=.env src/jobs/run-once.ts send-instant",
    "job:send-digests": "tsx --env-file-if-exists=.env src/jobs/run-once.ts send-digests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/s3-presigned-post": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "@fastify/cors": "11.4.0",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@titan/contracts": "workspace:*",
    "@titan/domain": "workspace:*",
    "expo-server-sdk": "8.0.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.15",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
